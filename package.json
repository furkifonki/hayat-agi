{
  "name": "hayat-agi",
  "version": "0.1.0",
  "private": true,
  "description": "Hayat Ağı — Volunteer emergency support coordination platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@hayat-agi/mobile",
    "mobile:ios": "npm run ios:sim --workspace=@hayat-agi/mobile",
    "mobile:dev": "npm run start:dev --workspace=@hayat-agi/mobile",
    "mobile:web": "npm run web --workspace=@hayat-agi/mobile",
    "admin": "npm run dev --workspace=@hayat-agi/admin",
    "shared:build": "npm run build --workspace=@hayat-agi/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
